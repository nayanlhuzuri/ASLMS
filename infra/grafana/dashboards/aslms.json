{
  "title": "ASLMS — system and data collection",
  "uid": "aslms-overview",
  "schemaVersion": 39,
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "1m",
  "panels": [
    {
      "type": "stat", "title": "Hours since last successful daily cycle", "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "datasource": { "uid": "prometheus" },
      "targets": [{ "expr": "aslms_last_daily_cycle_age_seconds / 3600" }],
      "fieldConfig": { "defaults": { "decimals": 1, "thresholds": { "mode": "absolute", "steps": [
        { "color": "green", "value": null }, { "color": "orange", "value": 8 }, { "color": "red", "value": 14 } ] } } }
    },
    {
      "type": "stat", "title": "Open data-collection failures", "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
      "datasource": { "uid": "prometheus" },
      "targets": [{ "expr": "aslms_open_source_failures" }],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [
        { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } } }
    },
    {
      "type": "stat", "title": "Tracked cases", "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
      "datasource": { "uid": "prometheus" },
      "targets": [{ "expr": "aslms_cases{state=\"tracked\"}" }]
    },
    {
      "type": "stat", "title": "Open critical alerts", "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 },
      "datasource": { "uid": "prometheus" },
      "targets": [{ "expr": "aslms_open_alerts{severity=\"critical\"}" }]
    },
    {
      "type": "timeseries", "title": "API requests per second by status", "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [{ "expr": "sum by (status) (rate(aslms_http_requests_total[5m]))", "legendFormat": "{{status}}" }]
    },
    {
      "type": "timeseries", "title": "API latency p95 (s)", "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(aslms_http_request_seconds_bucket[5m])))", "legendFormat": "p95" }]
    },
    {
      "type": "timeseries", "title": "Celery tasks (Flower)", "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [{ "expr": "sum by (task, state) (rate(flower_events_total[15m]))", "legendFormat": "{{task}} {{state}}" }]
    },
    {
      "type": "timeseries", "title": "PostgreSQL connections", "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [{ "expr": "sum(pg_stat_activity_count)", "legendFormat": "connections" }]
    }
  ]
}
