    {
      "name": "03 · HC Bench master",
      "request": {
        "method": "GET",
        "description": "Lists benches with est_code. Confirm Principal Seat est_code (expected GAHC01) and set est_code.",
        "header": [
          {
            "key": "X-Plain",
            "value": "state_code={{state_code}}",
            "description": "Plain key=value|key=value string; encrypted automatically"
          }
        ],
        "url": {
          "raw": "{{base_url}}/hc-bench-master-api/bench?dept_id={{dept_id}}&request_str={{request_str_enc}}&request_token={{request_token}}&version={{version}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "hc-bench-master-api",
            "bench"
          ],
          "query": [
            {
              "key": "dept_id",
              "value": "{{dept_id}}"
            },
            {
              "key": "request_str",
              "value": "{{request_str_enc}}"
            },
            {
              "key": "request_token",
              "value": "{{request_token}}"
            },
            {
              "key": "version",
              "value": "{{version}}"
            }
