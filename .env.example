# Copy to .env and fill in. .env is git-ignored. Never commit real values. The runbook is docs/operations.md.
# Generate every secret below with `openssl rand -hex 32` or
#   python -c "import secrets;print(secrets.token_hex(32))"
# and use a different value for each. `aslms ops preflight` (the first step of the Compose `init` service) names any
# missing, short, default or repeated secret; with APP_ENV=prod it refuses to start (design deployment-checklist).

# dev | test | prod. The pilot runs with prod: JSON logs, no console mail, no API documentation, strict preflight.
APP_ENV=dev
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata

# --- Compose ------------------------------------------------------------------------------------------------------
# Development: the override publishes postgres, api and web on 127.0.0.1 only (5433, 8000, 3000). Leave it out on the
# pilot (COMPOSE_FILE=compose.yml), where only the proxy publishes 443 and 80. COMPOSE_PATH_SEPARATOR=: makes `:` the separator on every system (Docker on Windows uses `;` without it).
COMPOSE_PATH_SEPARATOR=:
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=compose.yml:compose.dev.yml
# ClamAV without general internet access: add compose.clamav-mirror.yml or compose.clamav-offline.yml to COMPOSE_FILE.
# Profiles: `ops` holds the migrate service (run it explicitly, never with up); `monitoring` holds Prometheus,
# Alertmanager, Grafana, Flower and the exporters (design deployment-checklist, Part B). The pilot sets
# COMPOSE_PROFILES=monitoring, and with APP_ENV=prod preflight refuses a stack without it. On a Linux VM at the SDC,
# `monitoring,monitoring-host` adds node-exporter and cadvisor. Development may leave it blank.
COMPOSE_PROFILES=

# --- Postgres (DB_STANDARD §8) ------------------------------------------------------------------------------------
# POSTGRES_USER is the cluster superuser, used only by the Compose `init`, `migrate` and `backup` services; the api,
# worker and scheduler connect as aslms_app with ASLMS_APP_PASSWORD. REQUIRED: POSTGRES_PASSWORD (16+ characters,
# letters, digits, `_` or `-`). It applies only when the cluster is first created; to change it later run
# `ALTER ROLE aslms PASSWORD '...'` in psql first (docs/operations.md, "Secret rotation").
POSTGRES_USER=aslms
POSTGRES_PASSWORD=
POSTGRES_DB=aslms
# development only (compose.dev.yml): the host ports on 127.0.0.1
POSTGRES_HOST_PORT=5433
API_HOST_PORT=8000
# Host-side commands (the CLI outside Compose) connect as aslms_app; ASLMS_MIGRATE_URL is the owner, for
# `alembic upgrade head` and `aslms db-roles` from the host. Compose builds its own URLs from the passwords.
DATABASE_URL_SYNC=postgresql+psycopg://aslms_app:<ASLMS_APP_PASSWORD>@127.0.0.1:5433/aslms
ASLMS_MIGRATE_URL=postgresql+psycopg://aslms:<POSTGRES_PASSWORD>@127.0.0.1:5433/aslms
# REQUIRED: the aslms_app password, at least 16 letters, digits, `_` or `-`. Set on the role by `aslms db-roles` at
# every Compose `init` run; `docker compose up` refuses to start without it, and db-roles refuses an empty, short or
# default value.
ASLMS_APP_PASSWORD=
# REQUIRED (from Part B): the aslms_readonly password (same rules, different from the others). The postgres exporter
# and the ASLMS operations exporter connect as aslms_readonly; `docker compose up` refuses to start without it.
# PgBouncer (Part C) also uses it for aslms_readonly's stats login on its console (the pgbouncer exporter).
ASLMS_READONLY_PASSWORD=
# Postgres memory and planner settings (decision 15), sized for 8 GB given to Docker and SSD storage:
# shared_buffers ~25 % of Docker's memory, effective_cache_size 50-75 %
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=4GB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=256MB
PG_MAX_CONNECTIONS=100
# PgBouncer (Part C, decision 29; docs/operations.md section 18): api, worker and scheduler connect through it in
# transaction mode. Keep the pool well under PG_MAX_CONNECTIONS.
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_DEFAULT_POOL_SIZE=20
PGBOUNCER_MAX_PREPARED_STATEMENTS=200

# --- Redis (decision 6) -------------------------------------------------------------------------------------------
# REQUIRED: the Redis password (16+ letters, digits, `_` or `-`; it goes into the Redis URL unencoded). Redis is never
# published and keeps nothing on disk. Compose builds REDIS_URL for its services; this one is for host-run commands.
REDIS_PASSWORD=

# --- Backups (decisions 13, 14) -----------------------------------------------------------------------------------
# The host folder for dumps, roles, manifests, the store mirror and the status files: put it on a second physical
# disk (e.g. E:/aslms-backups) and copy it weekly to an encrypted external drive kept away from the machine.
BACKUP_DIR=./backups
# a backup at minute 30 of every BACKUP_INTERVAL_HOURS hours, IST (1-24); the restore check runs Sunday 04:30 IST
BACKUP_INTERVAL_HOURS=6
# retention of dump sets (the store mirror is never pruned): everything for BACKUP_KEEP_RECENT_HOURS, the first set
# of each day, each Sunday and each 1st of the month for these many days / weeks / months, the last pre-migrate sets
BACKUP_KEEP_RECENT_HOURS=48
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12
BACKUP_KEEP_PREMIGRATE=5

# --- Monitoring (design deployment-checklist, Part B, decisions 22-28; docs/operations.md section 17) ---------------
# Grafana http://127.0.0.1:3001, Prometheus :9090, Alertmanager :9093 and Flower :5555, on the host's loopback only
# (an SSH tunnel at the SDC). REQUIRED even without the profile (Compose checks every service's variables):
# GRAFANA_ADMIN_PASSWORD (16+ characters; the `admin` login, applied when Grafana's volume is first created) and
# FLOWER_BASIC_AUTH as user:password (password 16+ characters). Both differ from every other password.
GRAFANA_ADMIN_PASSWORD=
FLOWER_BASIC_AUTH=
# Who receives the monitoring alerts. Alertmanager mails them through the SMTP_* settings of the mail section;
# without SMTP_HOST or OPS_ALERT_EMAIL the alerts are shown in Grafana and Alertmanager only (a preflight warning).
OPS_ALERT_EMAIL=
# Prometheus keeps this much history
PROMETHEUS_RETENTION=30d

# --- The reverse proxy (decisions 7-10) ---------------------------------------------------------------------------
# The proxy publishes 443 and 80 (80 only redirects) on PROXY_BIND. Its certificate and key are
# infra/proxy/certs/fullchain.pem and privkey.pem (`aslms ops make-cert --host <name> --ip <address>`, or NIC / SDC).
PROXY_BIND=0.0.0.0
PROXY_HTTPS_PORT=443
PROXY_HTTP_PORT=80
# per client address: sign-in, code, resend and reset; the rest of the API; open connections. A whole office often
# shares one NAT address, so these are generous.
PROXY_SESSION_RATE=20r/m
PROXY_SESSION_BURST=20
PROXY_API_RATE=30r/s
PROXY_API_BURST=100
PROXY_CONN_PER_IP=50
# a load balancer in front of the proxy (SDC): its address range (CIDR), so the client's address is taken from it
PROXY_TRUSTED_UPSTREAM=

# Authentication: a long random string (32+ characters); the first super admin is created by `aslms seed` (and the
# Compose init step) when both ASLMS_SUPERADMIN_* values are set. Clear ASLMS_SUPERADMIN_PASSWORD after the super
# admin's first sign-in (preflight warns while it is set).
ASLMS_JWT_SECRET=
ASLMS_ACCESS_TOKEN_MINUTES=30
ASLMS_REFRESH_TOKEN_DAYS=14
ASLMS_SUPERADMIN_EMAIL=
ASLMS_SUPERADMIN_PASSWORD=
# Sign-in codes (design otp-and-profile): a 6-digit code is e-mailed at every sign-in, so a working mail service
# (the Mailtrap sandbox in development, below) is required to sign in; there is no bypass. A code lives
# OTP_TTL_MINUTES and allows OTP_MAX_ATTEMPTS tries; a new code for the same purpose at most every
# OTP_RESEND_SECONDS and at most OTP_MAX_PER_HOUR codes per login; LOGIN_MAX_FAILURES failed passwords or codes
# within LOGIN_LOCK_MINUTES lock that login until the window passes. Passwords: 10+ characters, a letter and a digit.
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=120
OTP_MAX_PER_HOUR=10
LOGIN_MAX_FAILURES=10
LOGIN_LOCK_MINUTES=15
# Document store and the website cause-list PDFs (fallback source for the historical load)
STORAGE_DIR=data/store
CAUSELIST_DIR=data/causelists
REDIS_URL=redis://localhost:6379/0

# --- NAPIX eCourts High Court API (official primary source; docs/napix_integration_notes.md) ---
# master switch: nothing calls the gateway until this is true
NAPIX_ENABLED=false
# NAPIX subscriber application Key / Secret (Basic Auth on the token call)
NAPIX_CLIENT_ID=
NAPIX_CLIENT_SECRET=
# Department ID = subscriber user name, sent as dept_id
NAPIX_DEPT_ID=
# Authentication Key from the e-Committee / High Court; used as the AES-128 key and IV (16 bytes, text)
NAPIX_AUTH_KEY=
# fixed HMAC key published in the spec
NAPIX_HASH_KEY=15081947
NAPIX_BASE_URL=https://delhigw.napix.gov.in/nic/ecourts
# Gauhati High Court establishment code (verified live)
NAPIX_EST_CODE=GAHC01
NAPIX_VERSION=v1.0
# optional tunables (defaults shown)
# Gauhati High Court's code in the NAPIX state master (verified live: 18; 6 is Chhattisgarh)
NAPIX_STATE_CODE=18
NAPIX_RATE_LIMIT_PER_MIN=60
# Gateway quota window length: 1,000 calls per window; the phase is detected from X-RateLimit-Remaining
# (design napix-window; notes §6), never assumed to be the clock hour
NAPIX_RATE_WINDOW_SECONDS=3600
# Wait this many seconds after the expected reset (0-600)
NAPIX_WINDOW_MARGIN_SECONDS=60
# One check call at most this often while the reset is late or the timing unknown (60-300)
NAPIX_WINDOW_PROBE_SECONDS=180
# A rise of at least this many remaining calls between two readings is a reset (10-500)
NAPIX_WINDOW_RESET_JUMP=50
# Calls kept back for the daily cycle; the load queue stops pulling below this X-RateLimit-Remaining
NAPIX_RATE_RESERVE=150
# Below this remaining hourly quota the queue worker claims nothing; between it and NAPIX_RATE_RESERVE only the
# daily cycle and people's requests run (the backdated load waits). Must hold:
# NAPIX_SEARCH_FLOOR <= NAPIX_LIVE_RESERVE <= NAPIX_RATE_RESERVE
NAPIX_LIVE_RESERVE=100
# CNRs per Current Status call (the gateway refuses more than ~300 with HTTP 414)
NAPIX_STATUS_BATCH=250
NAPIX_TIMEOUT_SECONDS=40
# used only when the token response carries no expires_in (the manual says one hour)
NAPIX_TOKEN_TTL_SECONDS=3300
# User court searches (POST /cases/search-court, /cases/{ref}/fetch-court): refused when the remaining hourly
# quota is below the floor; at most this many per user per hour; the whole request within this many seconds
NAPIX_SEARCH_FLOOR=50
NAPIX_SEARCH_PER_USER_HOUR=30
NAPIX_SEARCH_TIMEOUT_SECONDS=60
# Gateway faults (design safety-fixes): after NAPIX_FAULT_STREAK queue items in a row fail as unavailable (an empty
# HTTP 200 body included; 3-50), the worker pauses NAPIX_FAULT_PAUSE_SECONDS (60-3600). Failed rows are retried
# 10 min, 1 h, 6 h, 24 h and 72 h later, then marked failed.
NAPIX_FAULT_STREAK=5
NAPIX_FAULT_PAUSE_SECONDS=300
# Advocate court searches (the court matches part of a name): the first NAPIX_ADVOCATE_STORE_NOW new cases (1-100)
# are stored in the request; when the court's distinct cases number at most NAPIX_ADVOCATE_STORE_MAX (25-2000, not
# below STORE_NOW) the rest are stored in the background within minutes, otherwise not at all (type more of the name)
NAPIX_ADVOCATE_STORE_NOW=25
NAPIX_ADVOCATE_STORE_MAX=300
# The connectivity check on the data-health screen (POST /admin/napix/health/check, one Overview call): refused when
# an Overview call was logged within this many seconds (10-3600)
NAPIX_HEALTH_CHECK_MIN_SECONDS=60

# --- Documents and uploads (design documents-uploads) ----
# Size limit per uploaded file (bytes; 20 MB). Keep below ClamAV's StreamMaxLength (25 MB default). The proxy reads
# this value (and ATTACHMENTS_MAX_FILES) at start, so its body limits always match the API's.
UPLOAD_MAX_BYTES=20971520
# ClamAV daemon (`clamd`) that scans every upload before it is stored; Compose sets CLAMAV_HOST=clamav.
# There is no switch to turn the scan off: with clamd unreachable, uploads answer 503.
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
# Documents whose text is extracted per run of the 5-minute `extract-text` beat
TEXT_EXTRACT_BATCH=50

# --- Custody and workflow (design custody-workflow) ----
# new files attached to one note (each within UPLOAD_MAX_BYTES), the longest note, drafts per holder per case
ATTACHMENTS_MAX_FILES=5
NOTE_MAX_CHARS=20000
NOTE_DRAFTS_MAX=20

# --- SourceTrace (design sourcetrace-connector) ----
# Only court orders and court filings are ever sent; never notes or internal documents. No HTTP connector exists
# yet: with SOURCETRACE_ENABLED=false (or true, until the connector is built) nothing is sent and documents wait
# as `pending`. The key is a secret: never logged, never stored in an ingestion record.
SOURCETRACE_ENABLED=false
SOURCETRACE_BASE_URL=
SOURCETRACE_API_KEY=
# per 5-minute run: at most SOURCETRACE_BATCH documents, no new claim after SOURCETRACE_RUN_SECONDS; one send
# times out after SOURCETRACE_TIMEOUT_SECONDS; after SOURCETRACE_MAX_ATTEMPTS (10, 20, 40, 80 min back-off) a
# document is `failed`
SOURCETRACE_BATCH=20
SOURCETRACE_RUN_SECONDS=240
SOURCETRACE_TIMEOUT_SECONDS=60
SOURCETRACE_MAX_ATTEMPTS=5

# --- Mail and alerts (design alerts-notifications) ----
# MAIL_BACKEND: auto | api | smtp | console. `auto` prefers the Mailtrap API token, then SMTP, then the console
# (which logs the masked recipient and the subject only). The sender address (SMTP_FROM, every backend) must be
# on a domain verified with the provider. Secrets are never logged.
MAIL_BACKEND=auto
MAILTRAP_API_TOKEN=
# the sending URL (https://send.api.mailtrap.io/api/send) or the sandbox URL
# (https://sandbox.api.mailtrap.io/api/send/<inbox id>)
MAILTRAP_API_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=
SMTP_FROM_NAME=ASLMS
MAIL_TIMEOUT_SECONDS=20
# REQUIRED: links in mails (<PORTAL_BASE_URL>/cases/<ref>), the only Origin the portal accepts for writes and the
# host name the proxy answers to. Development: http://localhost:3000. Pilot: https://<the host's name or address>
# (preflight refuses anything but https:// when APP_ENV=prod).
PORTAL_BASE_URL=
# --- portal (Compose `web`, design portal-shell) ----------------------------
# the web service gets only these and PORTAL_BASE_URL / ASLMS_REFRESH_TOKEN_DAYS, never this file.
# WEB_HOST_PORT: development only (compose.dev.yml, 127.0.0.1)
WEB_HOST_PORT=3000
# session cookies carry Secure unless false (development over plain http only; preflight refuses false in prod)
COOKIE_SECURE=true
RELAY_TIMEOUT_SECONDS=120
# the web <-> api network; the api trusts X-Forwarded-For only from WEB_IP
ASLMS_SUBNET=172.28.0.0/24
WEB_IP=172.28.0.10
# hearing alerts this many days ahead; critical within this many hours of the sitting (COURT_SITTING_TIME, IST)
ALERT_HEARING_LOOKAHEAD_DAYS=7
ALERT_CRITICAL_HOURS=48
COURT_SITTING_TIME=10:30
# an order or a disposal older than this raises no alert (the historical load stays silent)
ALERT_EVENT_MAX_AGE_DAYS=14
# the event scan re-reads this much of the previous run's window (dedupe keys make it harmless)
ALERT_EVENT_OVERLAP_MINUTES=30
# informational alerts expire after this; compliance alerts this long after their date
ALERT_INFO_EXPIRE_DAYS=14
ALERT_COMPLIANCE_EXPIRE_DAYS=30
# a file held with a due date within this many days is `high` (workflow alert); overdue is `critical`
REQUEST_DUE_SOON_DAYS=2
# e-mail attempts per notification (5, 30 and 120 minutes apart) and rows per sender run
NOTIFY_MAX_ATTEMPTS=3
NOTIFY_BATCH=200

# --- Dashboards and reports (design reports-dashboards) ----
# hearings-disposals and data-health periods (days, inclusive); case rows per Excel / PDF section (a capped file
# says "first N of M rows"); every dashboard and report query runs under this statement timeout (seconds); rows
# in each dashboard list
REPORT_MAX_RANGE_DAYS=366
REPORT_HEALTH_MAX_DAYS=92
REPORT_XLSX_MAX_ROWS=5000
REPORT_PDF_MAX_ROWS=1000
REPORT_STATEMENT_TIMEOUT_SECONDS=30
DASHBOARD_LIST_SIZE=10

# --- The data-load console (design data-load-console) ----
# the estimated finish of the backdated load uses rates measured over this many days (1-30)
DATA_LOAD_ESTIMATE_WINDOW_DAYS=7

# --- Department discovery (design department-discovery) ----
# calls per detected quota window that the discovery lane (party-name searches of the departments' keywords and
# name patterns, and the dossiers of the cases they find) may make (0-1000; 0 stops discovery, rows wait)
NAPIX_DISCOVERY_SHARE=100
# the weekly and first sweeps search registration years from this one to the current year (1950 to this year);
# older years are searched only when a user asks for them on the Court search tab
DISCOVERY_FROM_YEAR=2025

# --- Next dates from orders (design next-date-extraction) ----
# orders whose stored text is read per run of the 5-minute `next-dates-read` beat (1-5000); an unclear or scanned
# current order of a claimed case asks for a date by hand for this many days after the order (7-120); a date read
# from an order or entered by hand lies at most this many days ahead (90-1095). No NAPIX or SourceTrace call.
NEXT_DATE_BATCH=500
NEXT_DATE_UNCLEAR_DAYS=30
NEXT_DATE_MAX_AHEAD_DAYS=548
