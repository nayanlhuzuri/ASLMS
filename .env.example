# Copy to .env and fill in. Everything has a working local default except the NAPIX credentials.
# .env is git-ignored. Never commit real values.

APP_ENV=dev                      # dev | test | prod
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata
SECRET_KEY=change-me-to-a-long-random-string     # JWT signing; rotate in prod
PUBLIC_BASE_URL=http://localhost:3000            # used in e-mail links

# --- Postgres (docker-compose overrides the host name for containers) ---------
POSTGRES_USER=aslms
POSTGRES_PASSWORD=aslms
POSTGRES_DB=aslms
POSTGRES_HOST_PORT=5433          # host port; a native PostgreSQL often already holds 5432 on Windows
DATABASE_URL=postgresql+asyncpg://aslms:aslms@localhost:5433/aslms
DATABASE_URL_SYNC=postgresql+psycopg://aslms:aslms@localhost:5433/aslms
REDIS_URL=redis://localhost:6379/0

# --- Document storage ------------------------------------------------------------
STORAGE_ROOT=./data/storage
UPLOAD_MAX_MB=25
CLAMAV_HOST=localhost            # clamd; leave empty to skip scanning in dev (uploads are then marked "failed")
CLAMAV_PORT=3310

# --- Cause-list PDFs on disk (local source / cross-check) --------------------------
CAUSE_LIST_DIR=./data/causelists

# --- NAPIX eCourts High Court API (official primary source) -------------------------
NAPIX_BASE=https://delhigw.napix.gov.in/nic/ecourts
NAPIX_CLIENT_ID=
NAPIX_CLIENT_SECRET=
NAPIX_DEPT_ID=
NAPIX_AUTH_KEY=                  # 16-character e-Committee authentication key; also used as the IV
NAPIX_AUTH_KEY_MODE=text         # text | hex | base64 — how NAPIX_AUTH_KEY is written
NAPIX_HASH_KEY=15081947          # fixed HMAC key from the spec, Annexure A
NAPIX_VERSION=v1.0
NAPIX_STATE_CODE=6               # verify with hc-state-api
NAPIX_HC_EST_CODE=GAHC01         # Principal Seat; verify with hc-bench-master-api
NAPIX_RATE_LIMIT_PER_MIN=60
NAPIX_TIMEOUT_SECONDS=40

# --- GHC website (supplementary cross-check) ---------------------------------------
GHC_CAUSELIST_BASE=https://ghconline.gov.in

# --- SourceTrace (in-house RAG; connector is a stub until endpoints are provided) ----
SOURCETRACE_BASE_URL=
SOURCETRACE_API_KEY=
SOURCETRACE_ENABLED=false

# --- Notifications -------------------------------------------------------------------
SMTP_HOST=                       # empty = OTPs and e-mails are logged to the console
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@aslms.assam.gov.in
SMS_GATEWAY_URL=                 # Phase 2
SMS_GATEWAY_KEY=

# --- Auth -----------------------------------------------------------------------------
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# --- Ownership scoring ------------------------------------------------------------------
SCORE_STRONG_THRESHOLD=0.85
SCORE_POSSIBLE_THRESHOLD=0.50
