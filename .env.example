# Copy to .env and fill in. Everything has a working local default except the NAPIX credentials.
# .env is git-ignored. Never commit real values. Variables return module by module as the rebuild proceeds.

# dev | test | prod
APP_ENV=dev
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata

# --- Postgres / Redis (DB_STANDARD §8: the application connects as aslms_app, migrations as the owner) ----------
POSTGRES_USER=aslms
POSTGRES_PASSWORD=aslms
POSTGRES_DB=aslms
POSTGRES_HOST_PORT=5433
API_HOST_PORT=8000
DATABASE_URL_SYNC=postgresql+psycopg://aslms:aslms@localhost:5433/aslms
ASLMS_MIGRATE_URL=
ASLMS_APP_PASSWORD=aslms_app
ASLMS_READONLY_PASSWORD=aslms_readonly
# Authentication: a long random string (e.g. `openssl rand -hex 32`); the first super admin is created by
# `aslms seed` (and the Compose init step) when both ASLMS_SUPERADMIN_* values are set
ASLMS_JWT_SECRET=
ASLMS_ACCESS_TOKEN_MINUTES=30
ASLMS_REFRESH_TOKEN_DAYS=14
ASLMS_SUPERADMIN_EMAIL=
ASLMS_SUPERADMIN_PASSWORD=
# Document store and the website cause-list PDFs (fallback source for the historical load)
STORAGE_DIR=data/store
CAUSELIST_DIR=data/causelists
REDIS_URL=redis://localhost:6379/0

# --- NAPIX eCourts High Court API (official primary source; docs/napix_integration_notes.md) ---
# master switch: nothing calls the gateway until this is true
NAPIX_ENABLED=false
# NAPIX subscriber application Key / Secret (Basic Auth on the token call)
NAPIX_CLIENT_ID=
NAPIX_CLIENT_SECRET=
# Department ID = subscriber user name, sent as dept_id
NAPIX_DEPT_ID=
# Authentication Key from the e-Committee / High Court; used as the AES-128 key and IV (16 bytes, text)
NAPIX_AUTH_KEY=
# fixed HMAC key published in the spec
NAPIX_HASH_KEY=15081947
NAPIX_BASE_URL=https://delhigw.napix.gov.in/nic/ecourts
# Gauhati High Court establishment code (verified live)
NAPIX_EST_CODE=GAHC01
NAPIX_VERSION=v1.0
# optional tunables (defaults shown)
# Gauhati High Court's code in the NAPIX state master (verified live: 18; 6 is Chhattisgarh)
NAPIX_STATE_CODE=18
NAPIX_RATE_LIMIT_PER_MIN=60
# Gateway quota window: 1,000 calls per clock hour measured on 1 Oct 2026 (notes §6)
NAPIX_RATE_WINDOW_SECONDS=3600
# Calls kept back for the daily cycle; the load queue stops pulling below this X-RateLimit-Remaining
NAPIX_RATE_RESERVE=150
# CNRs per Current Status call (the gateway refuses more than ~300 with HTTP 414)
NAPIX_STATUS_BATCH=250
NAPIX_TIMEOUT_SECONDS=40
# used only when the token response carries no expires_in (the manual says one hour)
NAPIX_TOKEN_TTL_SECONDS=3300
# User court searches (POST /cases/search-court, /cases/{ref}/fetch-court): refused when the remaining hourly
# quota is below the floor; at most this many per user per hour; the whole request within this many seconds
NAPIX_SEARCH_FLOOR=50
NAPIX_SEARCH_PER_USER_HOUR=30
NAPIX_SEARCH_TIMEOUT_SECONDS=60

# --- Documents and uploads (design documents-uploads) ----
# Size limit per uploaded file (bytes; 20 MB). Keep below ClamAV's StreamMaxLength (25 MB default) and set the
# reverse proxy's client_max_body_size to match.
UPLOAD_MAX_BYTES=20971520
# ClamAV daemon (`clamd`) that scans every upload before it is stored; Compose sets CLAMAV_HOST=clamav.
# There is no switch to turn the scan off: with clamd unreachable, uploads answer 503.
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
# Documents whose text is extracted per run of the 5-minute `extract-text` beat
TEXT_EXTRACT_BATCH=50

# --- Custody and workflow (design custody-workflow) ----
# new files attached to one note (each within UPLOAD_MAX_BYTES), the longest note, drafts per holder per case
ATTACHMENTS_MAX_FILES=5
NOTE_MAX_CHARS=20000
NOTE_DRAFTS_MAX=20

# --- SourceTrace (in-house RAG; connector is a stub until endpoints are provided) ----
SOURCETRACE_BASE_URL=
SOURCETRACE_API_KEY=
SOURCETRACE_ENABLED=false

# --- Mail and alerts (design alerts-notifications) ----
# MAIL_BACKEND: auto | api | smtp | console. `auto` prefers the Mailtrap API token, then SMTP, then the console
# (which logs the masked recipient and the subject only). The sender address (SMTP_FROM, every backend) must be
# on a domain verified with the provider. Secrets are never logged.
MAIL_BACKEND=auto
MAILTRAP_API_TOKEN=
# the sending URL (https://send.api.mailtrap.io/api/send) or the sandbox URL
# (https://sandbox.api.mailtrap.io/api/send/<inbox id>)
MAILTRAP_API_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=
SMTP_FROM_NAME=ASLMS
MAIL_TIMEOUT_SECONDS=20
# links in mails: <PORTAL_BASE_URL>/cases/<ref>
PORTAL_BASE_URL=http://localhost:3000
# hearing alerts this many days ahead; critical within this many hours of the sitting (COURT_SITTING_TIME, IST)
ALERT_HEARING_LOOKAHEAD_DAYS=7
ALERT_CRITICAL_HOURS=48
COURT_SITTING_TIME=10:30
# an order or a disposal older than this raises no alert (the historical load stays silent)
ALERT_EVENT_MAX_AGE_DAYS=14
# the event scan re-reads this much of the previous run's window (dedupe keys make it harmless)
ALERT_EVENT_OVERLAP_MINUTES=30
# informational alerts expire after this; compliance alerts this long after their date
ALERT_INFO_EXPIRE_DAYS=14
ALERT_COMPLIANCE_EXPIRE_DAYS=30
# a file held with a due date within this many days is `high` (workflow alert); overdue is `critical`
REQUEST_DUE_SOON_DAYS=2
# e-mail attempts per notification (5, 30 and 120 minutes apart) and rows per sender run
NOTIFY_MAX_ATTEMPTS=3
NOTIFY_BATCH=200
