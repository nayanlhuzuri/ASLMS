# Copy to .env and fill in. Everything has a working local default except the NAPIX credentials.
# .env is git-ignored. Never commit real values.

# dev | test | prod
APP_ENV=dev
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata
# JWT signing; rotate in prod
SECRET_KEY=change-me-to-a-long-random-string
# used in e-mail links
PUBLIC_BASE_URL=http://localhost:3000

# --- Postgres (docker-compose overrides the host name for containers) ---------
POSTGRES_USER=aslms
POSTGRES_PASSWORD=aslms
POSTGRES_DB=aslms
# host port; a native PostgreSQL often already holds 5432 on Windows
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+asyncpg://aslms:aslms@localhost:5433/aslms
# the API, workers and CLI connect as aslms_app (DB_STANDARD §8); on a laptop the superuser also works
DATABASE_URL_SYNC=postgresql+psycopg://aslms:aslms@localhost:5433/aslms
# migrations run as the owner (superuser / member of aslms_owner); empty = DATABASE_URL_SYNC
ASLMS_MIGRATE_URL=
# passwords the first migration gives the aslms_app and aslms_readonly roles; change before a server install
ASLMS_APP_PASSWORD=aslms_app
ASLMS_READONLY_PASSWORD=aslms_readonly
REDIS_URL=redis://localhost:6379/0

# --- Document storage ------------------------------------------------------------
STORAGE_ROOT=./data/storage
UPLOAD_MAX_MB=25
# clamd; leave empty to skip scanning in dev (uploads are then marked "failed")
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- Cause-list PDFs on disk (local source / cross-check) --------------------------
CAUSE_LIST_DIR=./data/causelists

# --- NAPIX eCourts High Court API (official primary source) -------------------------
# master switch: nothing calls the gateway until this is true
NAPIX_ENABLED=false
NAPIX_BASE=https://delhigw.napix.gov.in/nic/ecourts
NAPIX_CLIENT_ID=
NAPIX_CLIENT_SECRET=
NAPIX_DEPT_ID=
# 16-character e-Committee authentication key; also used as the IV
NAPIX_AUTH_KEY=
# text | hex | base64 — how NAPIX_AUTH_KEY is written
NAPIX_AUTH_KEY_MODE=text
# fixed HMAC key from the spec, Annexure A
NAPIX_HASH_KEY=15081947
NAPIX_VERSION=v1.0
# verify with hc-state-api
NAPIX_STATE_CODE=6
# Principal Seat; verify with hc-bench-master-api
NAPIX_HC_EST_CODE=GAHC01
NAPIX_RATE_LIMIT_PER_MIN=60
NAPIX_TIMEOUT_SECONDS=40

# --- GHC website (supplementary cross-check) ---------------------------------------
GHC_CAUSELIST_BASE=https://ghconline.gov.in
# unverified; e.g. https://…/{list_type}_{dd}-{mm}-{yyyy}.pdf
GHC_CAUSELIST_URL_TEMPLATE=

# --- SourceTrace (in-house RAG; connector is a stub until endpoints are provided) ----
SOURCETRACE_BASE_URL=
SOURCETRACE_API_KEY=
SOURCETRACE_ENABLED=false

# --- E-mail (sign-in codes, alerts, digests) -------------------------------------------
# MAIL_BACKEND: auto | mailtrap | smtp | console.
# auto = Mailtrap API if MAILTRAP_API_TOKEN is set, else SMTP if SMTP_HOST is set, else the console.
# In Docker on a laptop, SMTP_HOST defaults to the Mailpit catcher (http://localhost:8025).
MAIL_BACKEND=auto
#
# Option A: Mailtrap Email Sending API (token from Mailtrap -> Sending Domains -> Integration -> API).
# SMTP_FROM must be an address on a domain verified in Mailtrap.
MAILTRAP_API_TOKEN=
# live sending (default); for Mailtrap's testing sandbox use https://sandbox.api.mailtrap.io/api/send/<inbox_id>
MAILTRAP_API_URL=https://send.api.mailtrap.io/api/send
#
# Option B: any SMTP server. Mailtrap SMTP: SMTP_HOST=live.smtp.mailtrap.io, SMTP_PORT=587,
# SMTP_USER=api, SMTP_PASSWORD=<the same token>, SMTP_STARTTLS=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=no-reply@aslms.assam.gov.in
SMTP_FROM_NAME=ASLMS Legal Case Monitoring
# Phase 2
SMS_GATEWAY_URL=
SMS_GATEWAY_KEY=

# --- Auth -----------------------------------------------------------------------------
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
# minimum wait before "Resend code" works, and the cap on codes per account per hour
OTP_RESEND_SECONDS=120
OTP_MAX_PER_HOUR=10

# --- Ownership scoring ------------------------------------------------------------------
SCORE_STRONG_THRESHOLD=0.85
SCORE_POSSIBLE_THRESHOLD=0.50

# --- Bootstrap and jobs -----------------------------------------------------------------
# first central-operator account created by `aslms seed`
SEED_ADMIN_EMAIL=admin@aslms.local
# change before seeding anywhere but a laptop
SEED_ADMIN_PASSWORD=change-me
FIRST_SIGHT_BATCH=200
ORDER_DOWNLOAD_BATCH=200
FULL_REFRESH_DAYS=7
# extra comma-separated origins besides PUBLIC_BASE_URL
CORS_ORIGINS=
