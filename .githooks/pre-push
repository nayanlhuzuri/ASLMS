#!/bin/sh
# Optional pre-push hook (design github-and-ci, decision 9). Not switched on by default; the owner turns it on once:
#   git config core.hooksPath .githooks
# For each ref being pushed it runs backend/tools/repo_policy.py on the outgoing commits, and gitleaks on the same
# commits when gitleaks is on PATH. A finding stops the push; nothing is changed or rewritten here.
remote="$1"
root=$(git rev-parse --show-toplevel) || exit 1
zero=0000000000000000000000000000000000000000
if command -v python3 >/dev/null 2>&1 && python3 -c "" >/dev/null 2>&1; then py=python3; else py=python; fi
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue  # a delete pushes no commit (and the guard refuses it anyway)
  if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
    # a new ref on the remote: the commits no remote-tracking ref of this remote holds yet
    set -- -- "$local_sha" --not "--remotes=$remote"
    log_opts="$local_sha --not --remotes=$remote"
  else
    set -- "$remote_sha..$local_sha"
    log_opts="$remote_sha..$local_sha"
  fi
  echo "pre-push: repo_policy on $local_ref -> $remote_ref"
  "$py" "$root/backend/tools/repo_policy.py" range "$@" || status=1
  if command -v gitleaks >/dev/null 2>&1; then
    echo "pre-push: gitleaks on $local_ref"
    gitleaks git "$root" --config "$root/.gitleaks.toml" --redact --no-banner --log-opts="$log_opts" || status=1
  fi
done
if [ "$status" -ne 0 ]; then
  echo "pre-push: refused. Nothing above may reach the remote (docs/operations.md section 19)." >&2
fi
exit "$status"
