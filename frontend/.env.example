# Server-side only. Base URL of the ASLMS FastAPI backend, as reached from the Next.js server
# (inside docker compose this is usually http://api:8000). Never exposed to the browser.
API_BASE_URL=http://localhost:8000

# Session cookies are marked Secure when NODE_ENV=production. Set to "false" only for a pilot served
# over plain HTTP on a closed network; leave unset everywhere else.
COOKIE_SECURE=
